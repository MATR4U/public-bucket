# Server-local template  --  copy to /root/bootstrap.env on the target server.
# NEVER commit filled copies. Real values live in the private mail-server
# repo: config/sites/<site>.env (gitignored on this bucket).

SSH_ALLOW_IP=YOUR_ADMIN_PUBLIC_IP
SSH_PORT=YOUR_SSH_PORT
SSH_MANAGED_PORTS=YOUR_SSH_PORT,YOUR_ALT_SSH_PORT
SSH_HARDEN=false
SSH_PASSWORD_AUTH=true
# VAULT_PUBKEY=ssh-ed25519 YOUR_KEY_MATERIAL comment
